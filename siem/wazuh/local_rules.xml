<!-- Regras de detecção da Rede Vila Aurora no Wazuh (RT-13). Espelham siem/detector.py. -->
<group name="vila_aurora,">

  <!-- base: eventos JSON da plataforma -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="src">\.+</field>
    <description>Evento da Rede Vila Aurora</description>
  </rule>

  <!-- R1: login VPN anômalo / força bruta -->
  <rule id="100110" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100100</if_matched_sid>
    <field name="event">vpn_login_failed</field>
    <same_field>user</same_field>
    <description>R1: força bruta de autenticação VPN para $(user) [MITRE T1110]</description>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100111" level="10">
    <if_sid>100100</if_sid>
    <field name="event">vpn_login_success</field>
    <field name="mfa">false</field>
    <description>R1: login VPN sem MFA de $(user) do IP $(ip) [T1133/T1078]</description>
    <mitre><id>T1133</id><id>T1078</id></mitre>
  </rule>

  <!-- R2: padrão de SQL Injection na aplicação web -->
  <rule id="100120" level="12">
    <if_sid>100100</if_sid>
    <field name="src">panel|panel_legado|web</field>
    <field name="query" type="pcre2">(?i)union\s+select|information_schema|'\s*or\s*'1'\s*=\s*'1|--\s|/\*|pg_sleep</field>
    <description>R2: padrão de SQL Injection na aplicação web de $(ip) [T1190]</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- R3: dispositivo sem certificado válido no broker -->
  <rule id="100130" level="10">
    <decoded_as>json</decoded_as>
    <match>certificate verify failed|peer did not return a certificate</match>
    <description>R3: dispositivo sem certificado válido no broker MQTT [T1078.004]</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <!-- R4: comando de atuador recusado / fora de horário/perfil -->
  <rule id="100140" level="12">
    <if_sid>100100</if_sid>
    <field name="event">cloud_command_rejected</field>
    <description>R4: comando de atuador recusado pela borda ($(device)/$(action), motivo $(reason)) [T0831]</description>
    <mitre><id>T0831</id></mitre>
  </rule>
</group>
